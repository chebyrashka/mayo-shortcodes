PUBLIC_BASE_URL=http://localhost:4321
LINK_STORE_PATH=./data/links.json

# Local dev uses file storage by default. Netlify uses Blobs automatically.
# Set this only if you want to force Netlify Blobs in an environment that has
# NETLIFY_BLOBS_CONTEXT configured.
LINK_STORAGE=file
LINK_BLOBS_STORE=shortcodes
LINK_BLOBS_KEY=links
